ZSH_THEME="powerlevel10k/powerlevel10k"

unsetopt LIST_BEEP

# Disabled, not auto: ~/.oh-my-zsh is baked into the container image, so a self-update is
# a slow prompt for a change that's discarded on the next rebuild.
zstyle ':omz:update' mode disabled

COMPLETION_WAITING_DOTS="true"

# Read by omz lib/history.zsh, so it has to be set before oh-my-zsh.sh loads.
HIST_STAMPS="yyyy-mm-dd"

plugins=(git z gh)
